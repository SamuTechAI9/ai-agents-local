    {
      "parameters": {
        "jsCode": "const ef = $('Edit Fields').first().json;\nconst t = (ef.texto || '').trim();\nif (!t) return [];  // fotos, stickers o audios: no se guardan\n\nlet datos = {};\ntry {\n  datos = JSON.parse($input.first().json.content.replace(/```json|```/g, '').trim());\n} catch (e) {}\n\nconst low = t.toLowerCase();\nconst esNota = /^(nota|idea|tarea|recordar|apunta)/.test(low);\nconst pareceCharla = low.includes('?') || /^(hola|hey|buenas|qué tal|que tal|emi|dime|cómo va|como va)/.test(low);\nconst llamaDicePregunta = String(datos.tipo || '').toLowerCase().includes('pregunta');\n\nreturn [{ json: {\n  fecha: ef.fecha, texto: t,\n  resumen: datos.resumen || t, tags: datos.tags || '', categoria: datos.categoria || 'personal',\n  tipo: !esNota && (llamaDicePregunta || pareceCharla) ? 'pregunta' : 'nota',\n  update_id: ef.update_id\n}}];"
      },
